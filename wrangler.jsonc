{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assas-beaujolais-votes",
  "main": "live/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {"ALLOWED_ORIGINS":"https://cyrillea.github.io"},
  "durable_objects": {"bindings":[{"name":"ROOMS","class_name":"QuizRoom"},{"name":"LOGIN_LIMITS","class_name":"LoginLimit"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["QuizRoom"]},{"tag":"v2","new_sqlite_classes":["LoginLimit"]}],
  "observability": {"enabled": false}
}
