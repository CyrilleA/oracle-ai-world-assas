{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assas-beaujolais-votes",
  "main": "live/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory":"site","binding":"ASSETS","run_worker_first":true,"html_handling":"none"},
  "vars": {"SERVICE_ARCHIVED":"true","OPENAI_MODEL":"gpt-5-nano","ALLOWED_ORIGINS":"https://cyrillea.github.io"},
  "durable_objects": {"bindings":[{"name":"SUPPLY","class_name":"SupplyRoom"},{"name":"ROOMS","class_name":"QuizRoom"},{"name":"LOGIN_LIMITS","class_name":"LoginLimit"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["QuizRoom"]},{"tag":"v2","new_sqlite_classes":["LoginLimit"]},{"tag":"v3","new_sqlite_classes":["SupplyRoom"]}],
  "observability": {"enabled": false}
}
